class LocationsWidget extends StatelessWidget {
  final bool visible;
  final String dataType;
  final Function(String) onSampleSelected;
  final PageController pageController;

  LocationsWidget({
    required this.visible,
    required this.dataType,
    required this.onSampleSelected,
    required this.pageController,
  });

  @override
  Widget build(BuildContext context) {
    if (!visible) {
      return SizedBox.shrink();
    }

    final List<SampleData> sampleDataList = [
      SampleData(icon: Icons.engineering, name: 'SCRC LAB 1'),
      SampleData(icon: Icons.construction, name: 'HARDWARE LAB'),
      SampleData(icon: Icons.display_settings, name: 'DISPLAY BOARD'),
      SampleData(icon: Icons.laptop_mac, name: 'SOFTWARE LAB'),
    ];

    final double sampleWidth = 180.0;
    final double sampleHeight = 200.0;

    return SingleChildScrollView(  // Wrap with SingleChildScrollView
      scrollDirection: Axis.horizontal,  // Scroll horizontally
      physics: NeverScrollableScrollPhysics(),  // Disable scrolling
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceAround,
            children: sampleDataList.take(2).map((sampleData) {
              return Container(
                width: sampleWidth,
                height: sampleHeight,
                child: SampleWidget(
                  icon: sampleData.icon,
                  name: sampleData.name,
                  onSampleSelected: onSampleSelected,
                  pageController: pageController,
                ),
              );
            }).toList(),
          ),
          SizedBox(height: 20),
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceAround,
            children: sampleDataList.skip(2).map((sampleData) {
              return Container(
                width: sampleWidth,
                height: sampleHeight,
                child: SampleWidget(
                  icon: sampleData.icon,
                  name: sampleData.name,
                  onSampleSelected: onSampleSelected,
                  pageController: pageController,
                ),
              );
            }).toList(),
          ),
        ],
      ),
    );
  }
}

class SampleData {
  final IconData icon;
  final String name;

  SampleData({required this.icon, required this.name});
}

